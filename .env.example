# Production server
NODE_ENV=production
PORT=8080
PUBLIC_ORIGIN=https://your-domain.example

# Optional gateway/shared-secret guard.
# Enable this only when a reverse proxy can inject x-api-auth-key.
REQUIRE_API_AUTH_KEY=0
API_AUTH_KEY=replace-with-a-long-random-secret

# LLM free-trial fallback. User-provided keys in Settings take priority.
# For Volcengine Ark / Doubao, LLM_MODEL should be a model ID enabled in your Ark account.
# Some Ark accounts use endpoint-style IDs such as ep-xxxxxxxx; others use model IDs.
LLM_PROVIDER=doubao
LLM_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
LLM_MODEL=your-enabled-doubao-model-or-endpoint-id
LLM_API_KEY=your-volcengine-ark-api-key
FREE_LLM_QUOTA_LIMIT=5
FREE_LLM_QUOTA_WINDOW_MS=86400000
FREE_LLM_MAX_OUTPUT_TOKENS=2000

# Optional Doubao ASR / TTS free-trial fallback for public users without their own Doubao key.
DOUBAO_API_KEY=your-doubao-speech-api-key
DOUBAO_VOICE_FREE_QUOTA_LIMIT=20
DOUBAO_VOICE_FREE_QUOTA_WINDOW_MS=86400000

# Optional independent search. SEARCH_PROVIDER supports auto, baidu, tavily, bocha, serper, bing.
SEARCH_PROVIDER=auto
SEARCH_API_KEY=
BAIDU_SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5

# Free fallback quota for users who do not provide their own Search API Key.
# For small private beta usage, 30 searches per client IP per hour is usually generous.
SEARCH_FREE_QUOTA_LIMIT=30
SEARCH_FREE_QUOTA_WINDOW_MS=3600000

# Agent loops can make several LLM calls per user request. Users with their own
# LLM key can always use them; set this to 1 only when the server free quota is
# intentionally allowed to cover bounded agent and multi-agent runs as well.
ENABLE_FREE_AGENT_RUNTIME=0

# Keep shell/tool execution disabled for this lightweight deployment.
VIBE_TRADING_ENABLE_SHELL_TOOLS=0

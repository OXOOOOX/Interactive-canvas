# Production server
NODE_ENV=production
PORT=8080
PUBLIC_ORIGIN=https://your-domain.example

# Optional gateway/shared-secret guard.
# Enable this only when a reverse proxy can inject x-api-auth-key.
REQUIRE_API_AUTH_KEY=0
API_AUTH_KEY=replace-with-a-long-random-secret

# LLM free-trial fallback. User-provided keys in Settings take priority.
LLM_PROVIDER=deepseekV4Pro
LLM_ENDPOINT=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=sk-your-provider-key
FREE_LLM_QUOTA_LIMIT=5
FREE_LLM_QUOTA_WINDOW_MS=86400000
FREE_LLM_MAX_OUTPUT_TOKENS=2000

# Optional independent search. SEARCH_PROVIDER supports tavily, serper, bing.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5

# Free fallback quota for users who do not provide their own Search API Key.
# For small private beta usage, 30 searches per client IP per hour is usually generous.
SEARCH_FREE_QUOTA_LIMIT=30
SEARCH_FREE_QUOTA_WINDOW_MS=3600000

# Keep shell/tool execution disabled for this lightweight deployment.
VIBE_TRADING_ENABLE_SHELL_TOOLS=0
